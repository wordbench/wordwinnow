# NOTE:
# Per-project environment, and nothing more: direnv applies these exports when you enter this directory and removes
# them when you leave, so the command line finds them from any directory inside the repository and nowhere else.
#
# direnv is a convenience, not a requirement: `docs/operating.md` says how the command line and the services find the
# key without it.

# WARN:
# Nothing secret belongs in this file, because this file is committed.
#
# The New York Times key lives in one uncommitted file outside the repository, so no copy or archive of the working
# tree carries it, and `docker-compose.yml` reads the same file for the services:
#
#     ~/.config/wordwinnow/secrets.env
#
#         WORDWINNOW_NYT_API_KEY=<the key of your New York Times developer app>
#
# dotenv_if_exists watches that path, so direnv reloads when the file changes, and stays silent when it does not
# exist: a clone without it still works, and a `.env` beside `.env.example` remains a supported alternative.
dotenv_if_exists "${XDG_CONFIG_HOME:-${HOME}/.config}/wordwinnow/secrets.env"
